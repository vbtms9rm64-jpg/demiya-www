---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import LocationCard from "../components/LocationCard.astro";
import DishCard from "../components/DishCard.astro";
import Gallery from "../components/Gallery.astro";
import Reviews from "../components/Reviews.astro";
import InstagramCta from "../components/InstagramCta.astro";
import { locations } from "../data/locations";
import { hero, story, serve, gallery, reviews, findUs } from "../data/content";
import heroImg from "../assets/Demiya_Hero-scaled.jpg";
---

<BaseLayout
  title="Demiya — Japanese Comfort Food in the Bay Area"
  description={hero.body}
>
  <!-- Hero: element 06baec6 — radial overlay, 650px. See PageHero. -->
  <PageHero
    eyebrow={hero.eyebrow}
    heading={hero.heading}
    body={hero.body}
    overlay="radial"
    minHeight={650}
  >
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href="/locations-order/" class="btn btn-primary">Order Online</a>
      <a href="/locations-order/" class="btn btn-outline">Our Locations</a>
    </div>
  </PageHero>

  <!--
    Our Story — container ccc82cb in the original:
      flex-direction: row at base, --flex-wrap-mobile: wrap  → two columns
        from 768px, stacked below (NOT 1024px)
      image column first, text column second
      padding: 70px 20px

    Deliberate divergence: the original also carried a watercolour
    illustration (Cheese-hamburgcurry-scaled.jpg) as a background overlay,
    parallaxed above 1025px. Removed by request — the section now sits on the
    plain cream ground. To restore, re-add the asset and set it as a
    background-image here.
  -->
  <section class="story">
    <div class="story__inner">
      <div class="story__media">
        <Image
          src={heroImg}
          alt="Demiya curry"
          widths={[700, 1100, 1500]}
          sizes="(min-width: 1152px) 714px, (min-width: 768px) 62vw, 100vw"
          class="story__img"
        />
      </div>

      <div class="story__text">
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-brick">
          {story.eyebrow}
        </p>
        <h2 class="mt-3 font-display text-[38px] leading-tight font-semibold text-maroon">
          {story.heading}
        </h2>
        <div class="mt-6 flex flex-col gap-4 leading-relaxed text-rosewood">
          {story.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- What We Serve -->
  <Section eyebrow={serve.eyebrow} heading={serve.heading} body={serve.body}>
    <ul class="mt-12 grid grid-cols-1 gap-[15px] md:grid-cols-2 lg:grid-cols-3">
      {
        serve.dishes.map((dish) => (
          <li>
            <DishCard
              name={dish.name}
              description={dish.description}
              image={dish.image}
            />
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Gallery -->
  <Section eyebrow={gallery.eyebrow} heading={gallery.heading} body={gallery.body}>
    <Gallery images={gallery.images} />
  </Section>

  <!-- Reviews -->
  <Section eyebrow={reviews.eyebrow} heading={reviews.heading} body={reviews.body}>
    <Reviews />
  </Section>

  <InstagramCta />

  <!-- Find Us -->
  <Section eyebrow={findUs.eyebrow} heading={findUs.heading} body={findUs.body}>
    <div class="mt-12 grid grid-cols-1 gap-[15px] md:grid-cols-2 lg:grid-cols-3">
      {locations.map((location) => <LocationCard location={location} />)}
    </div>
  </Section>
</BaseLayout>

<style>
  .story {
    padding: 70px 20px;
  }

  .story__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 20px; /* Elementor's default container gap */
    max-width: 72rem;
    margin: 0 auto;
  }

  .story__media,
  .story__text {
    flex: 1 1 100%;
  }

  /*
   * Two columns from 768px — the original's breakpoint, not Tailwind's lg.
   * The image column is pinned at 62% and neither grows nor shrinks
   * (--width:62%, --flex-grow:0, --flex-shrink:0 on f755cdc). The text
   * column takes whatever is left. This is why the original does not
   * redistribute 50/50 as the window narrows.
   */
  @media (min-width: 768px) {
    .story__media {
      flex: 0 0 62%;
    }
    .story__text {
      flex: 1 1 0;
      min-width: 0;
    }
  }

  /*
   * Fixed height + cover: on resize the image CROPS horizontally rather than
   * scaling, anchored to bottom center. `height: auto` would scale it
   * proportionally, which is the behaviour that did not match.
   */
  .story__img {
    display: block;
    width: 100%;
    height: 633px;
    object-fit: cover;
    object-position: bottom center;
    border-radius: 10px;
  }

  @media (max-width: 767px) {
    .story__img {
      height: 268px;
    }
  }
</style>
