---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Contact — Demiya"
  description="Text Demiya about catering, feedback or an existing order."
>
  <section class="mx-auto max-w-2xl px-6 py-16">
    <h1 class="text-3xl font-semibold sm:text-4xl">Contact</h1>
    <p class="mt-3 text-rosewood">
      The fastest way to reach us — about an order, catering or anything else — is by text.
      This line receives texts only.
    </p>

    <a
      href={site.supportSmsHref}
      class="mt-10 inline-block rounded bg-brick px-6 py-3 font-medium text-cream transition-opacity hover:opacity-90"
    >
      Text {site.supportSms}
    </a>

    <p class="mt-10 text-rosewood">
      You can also find us on Instagram at{" "}
      <a href={site.instagram} class="underline underline-offset-4">{site.instagramHandle}</a>.
    </p>
  </section>
</BaseLayout>
