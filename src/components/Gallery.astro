---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * Reproduces the original's Elementor Pro Gallery widget (element 7547379)
 * and its lightbox slideshow.
 *
 * Grid, from the rendered CSS:
 *   --image-border-radius          10px
 *   --overlay-transition-duration  800ms
 *   aspect_ratio                   1:1
 *   columns                        3 (2 on mobile)
 *   hover / focus overlay          rgba(0,0,0,.5)
 *   (no zoom, no caption — unlike the dish cards)
 *
 * Lightbox, from elementor/assets/css/conditionals/lightbox.min.css:
 *   .elementor-lightbox-item       padding: 70px   (70px 0 below 767px)
 *   .elementor-lightbox-image      border-radius: 2px + double box-shadow
 *   .elementor-slideshow__header   absolute top, padding 15px 20px,
 *                                  row-reverse (counter left, close right)
 *   --lightbox-ui-color            hsla(0,0%,93%,.9), #fff on hover
 *   --lightbox-navigation-icons-size 25px
 *   prev/next                      15% wide, full height (20% below 767px)
 *
 * Slides are a Swiper v8 slideshow with Elementor's options — slidesPerView 1,
 * spaceBetween 100, loop true, and Swiper's default 300ms speed. Reproduced
 * here as a translated flex track with cloned end slides for seamless looping,
 * rather than swapping one <img> src (which gave no animation at all).
 */
interface Props {
  images: { src: ImageMetadata; alt: string }[];
}

const { images } = Astro.props;

const full = await Promise.all(
  images.map((img) => getImage({ src: img.src, width: 1600, format: "webp" })),
);

// [clone of last, ...real, clone of first] so looping never jumps visibly.
const slides = [
  { ...full[full.length - 1], alt: images[images.length - 1].alt },
  ...full.map((f, i) => ({ ...f, alt: images[i].alt })),
  { ...full[0], alt: images[0].alt },
];
---

<ul class="gallery">
  {
    images.map((img, i) => (
      <li class="gallery__cell">
        <a
          class="gallery__item"
          href={full[i].src}
          data-index={i}
          aria-label={`View ${img.alt} full size`}
        >
          <Image
            src={img.src}
            alt={img.alt}
            widths={[400, 800]}
            sizes="(min-width: 1024px) 360px, 50vw"
          />
          <span class="gallery__overlay" aria-hidden="true" />
        </a>
      </li>
    ))
  }
</ul>

<dialog class="lb" aria-label="Gallery">
  <div class="lb__viewport">
    <div class="lb__track">
      {
        slides.map((s, i) => (
          <div class="lb__slide" aria-hidden={i === 0 || i === slides.length - 1}>
            <img class="lb__img" src={s.src} alt={s.alt} decoding="async" loading="lazy" />
          </div>
        ))
      }
    </div>
  </div>

  <header class="lb__header">
    <button class="lb__close" type="button" aria-label="Close gallery">&times;</button>
    <span class="lb__counter" aria-live="polite"></span>
  </header>

  <button class="lb__nav lb__nav--prev" type="button" aria-label="Previous image">&#8249;</button>
  <button class="lb__nav lb__nav--next" type="button" aria-label="Next image">&#8250;</button>
</dialog>

<script>
  // Astro emits this as a module, so document.currentScript is null.
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".gallery__item"),
  );
  const dialog = document.querySelector<HTMLDialogElement>(".lb");

  if (dialog && links.length) {
    const track = dialog.querySelector<HTMLElement>(".lb__track")!;
    const counter = dialog.querySelector<HTMLElement>(".lb__counter")!;
    const count = links.length;

    // Track positions: 0 is the clone of the last slide, 1..count are real,
    // count+1 is the clone of the first.
    let pos = 1;
    let animating = false;

    const render = (animate: boolean) => {
      track.style.transitionDuration = animate ? "300ms" : "0ms";
      track.style.transform = `translateX(calc(${pos} * (-100% - 100px)))`;
      const real = ((pos - 1 + count) % count) + 1;
      counter.textContent = `${real} / ${count}`;
    };

    const go = (delta: number) => {
      if (animating) return;
      animating = true;
      pos += delta;
      render(true);
    };

    // When a clone finishes sliding, snap to its real counterpart with no
    // transition — the seam is never visible.
    track.addEventListener("transitionend", () => {
      if (pos === 0) {
        pos = count;
        render(false);
      } else if (pos === count + 1) {
        pos = 1;
        render(false);
      }
      animating = false;
    });

    links.forEach((a, i) =>
      a.addEventListener("click", (e) => {
        e.preventDefault();
        pos = i + 1;
        render(false);
        dialog.showModal();
      }),
    );

    dialog.querySelector(".lb__close")!.addEventListener("click", () => dialog.close());
    dialog.querySelector(".lb__nav--prev")!.addEventListener("click", () => go(-1));
    dialog.querySelector(".lb__nav--next")!.addEventListener("click", () => go(1));

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") go(1);
      if (e.key === "ArrowLeft") go(-1);
    });

    // Clicking the inert area around the photo closes, as the original did.
    dialog.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || t.classList.contains("lb__slide") || t.classList.contains("lb__viewport")) {
        dialog.close();
      }
    });
  }
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1024px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery__cell {
    margin: 0;
  }

  .gallery__item {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 10px;
    aspect-ratio: 1;
  }

  .gallery__item :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__overlay {
    position: absolute;
    inset: 0;
    background-color: transparent;
    transition: background-color 800ms;
  }

  .gallery__item:hover .gallery__overlay,
  .gallery__item:focus-visible .gallery__overlay {
    background-color: rgb(0 0 0 / 0.5);
  }

  /* ---- lightbox ---- */

  .lb {
    --ui: hsl(0 0% 93% / 0.9);
    --ui-hover: #fff;

    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .lb::backdrop {
    background: rgb(0 0 0 / 0.8);
  }

  .lb__viewport {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .lb__track {
    display: flex;
    gap: 100px; /* Swiper spaceBetween */
    width: 100%;
    height: 100%;
    transition-property: transform;
    transition-timing-function: ease;
    will-change: transform;
  }

  .lb__slide {
    flex: 0 0 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 70px; /* .elementor-lightbox-item */
    box-sizing: border-box;
  }

  .lb__img {
    max-width: 100%;
    max-height: 100%;
    border-radius: 2px;
    object-fit: contain;
    box-shadow:
      0 0 30px rgb(0 0 0 / 0.3),
      0 0 8px -5px rgb(0 0 0 / 0.3);
    user-select: none;
  }

  .lb__header {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    display: flex;
    flex-direction: row-reverse; /* close right, counter left */
    align-items: center;
    width: 100%;
    padding: 15px 20px;
    color: var(--ui);
    font-size: 20px; /* --lightbox-header-icons-size */
  }

  .lb__counter {
    margin-inline-end: auto;
    font-size: 0.75em;
    font-variant-numeric: tabular-nums;
  }

  .lb__close {
    padding: 0.25em;
    border: 0;
    background: none;
    color: inherit;
    font-size: 1.4em;
    line-height: 1;
    cursor: pointer;
    transition: color 0.3s;
  }

  .lb__nav {
    position: absolute;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 15%;
    height: 100%;
    border: 0;
    background: none;
    color: var(--ui);
    font-size: 25px; /* --lightbox-navigation-icons-size */
    line-height: 1;
    cursor: pointer;
    transition: color 0.3s;
  }

  .lb__nav--prev {
    left: 0;
  }
  .lb__nav--next {
    right: 0;
  }

  .lb__nav:hover,
  .lb__close:hover {
    color: var(--ui-hover);
  }

  @media (max-width: 767px) {
    .lb__slide {
      padding: 70px 0;
    }
    .lb__nav {
      width: 20%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__overlay {
      transition: none;
    }
    .lb__track {
      transition-duration: 0ms !important;
    }
  }
</style>
