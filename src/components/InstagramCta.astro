---
import { site } from "../data/site";
import { instagramCta } from "../data/content";
---

{/* Container 9cfb569 is 62% wide in the original. */}
<section class="border-y border-blush bg-blush/30">
  <div class="mx-auto w-full max-w-3xl px-5 py-14 text-center md:w-[62%]">
    <a
      href={site.instagram}
      rel="me noopener"
      class="font-display text-xl leading-relaxed text-maroon underline decoration-brick/40 underline-offset-8 transition-colors hover:text-brick sm:text-2xl"
    >
      {instagramCta}
    </a>
  </div>
</section>
