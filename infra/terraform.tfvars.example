# cp terraform.tfvars.example terraform.tfvars, then edit.

aws_region        = "us-west-2"
domain_name       = "demiya.restaurant"
route53_zone_name = "demiya.restaurant"

# Which hostname actually serves content. The other 301-redirects to it.
canonical_host = "demiya.restaurant"

# false until the site is deployed and verified via CloudFront; true moves
# the apex + www records off the old host. See variables.tf.
serve_from_cloudfront = false

# Must be globally unique across all of S3.
bucket_name = "demiya-www-origin"

# North America + Europe. Raise to PriceClass_All only if you have traffic
# from Asia-Pacific or South America worth paying for.
price_class = "PriceClass_100"


# Immutable OIDC subject (owner@id/repo@id) — see variables.tf.
github_repository = "vbtms9rm64-jpg@348009490/demiya-www@1433642341"
github_deploy_ref = "refs/heads/main"

# Set false if another stack in this AWS account already created the GitHub
# OIDC provider — an account can only hold one per URL.
create_github_oidc_provider = true
